<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="UI Playwright Suite" parallel="classes">
    <listeners>
        <listener class-name="listeners.AllurePlaywrightListener"/>
        <listener class-name="org.example.listeners.AllureListener"/>
    </listeners>
    <test name="Power of Playwright">
        <classes>
            <class name="cucumber.AllCucumberTests"/>
            <class name="testng.InterceptAndModifyResponseBodyTest"/>
            <class name="testng.VideoTest"/>
            <class name="testng.OfflineErrorTest"/>
            <class name="testng.TracingTest"/>
            <class name="testng.github.GitHubLoginWithoutStoredSessionTest"/>
<!--            <class name="testng.github.GitHubLoginByLoadingStoredSessionTest"/>-->
<!--            <class name="testng.github.GitHubWaitsTest"/>-->
        </classes>
    </test>
</suite>